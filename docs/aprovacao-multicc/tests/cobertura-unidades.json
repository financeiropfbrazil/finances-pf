{
  "data": "2026-09-07",
  "projeto": "hbtggrbauguukewiknew",
  "somente_leitura": true,
  "janela": "coalesce(data_abertura_alvo,created_at) >= date '2026-09-07' - 90",
  "consulta": "with recentes as (select * from compras_requisicoes where coalesce(data_abertura_alvo,created_at)>=date '2026-09-07'-90), produtos as (select distinct i.codigo_produto from recentes r join compras_requisicoes_itens i on i.requisicao_id=r.id), agregado as (select p.codigo_produto,count(u.posicao)::int unidades,count(*) filter(where u.posicao=1 and u.peso=1 and u.peso_fator_divisor='Fator')::int base_normalizada,count(*) filter(where u.posicao is not null and (u.peso_fator_divisor is distinct from 'Fator' or u.peso is null or u.peso<=0))::int nao_suportadas,min(u.sincronizado_em) as cache_mais_antigo,max(u.sincronizado_em) as cache_mais_novo from produtos p left join stock_produto_unidades u using(codigo_produto) group by p.codigo_produto) select (select count(*) from recentes)::int requisicoes,(select count(*) from recentes r where not exists(select 1 from compras_requisicoes_itens i where i.requisicao_id=r.id))::int requisicoes_sem_itens,(select count(*) from recentes r join compras_requisicoes_itens i on i.requisicao_id=r.id)::int itens,count(*)::int produtos,count(*) filter(where unidades=0)::int produtos_sem_escala,count(*) filter(where unidades>0)::int produtos_com_escala,count(*) filter(where unidades>0 and base_normalizada=0)::int escala_sem_base_normalizada,count(*) filter(where nao_suportadas>0)::int produtos_com_formato_nao_suportado,min(cache_mais_antigo) as cache_mais_antigo,max(cache_mais_novo) as cache_mais_novo from agregado",
  "consulta_detalhes": "with usados as (select i.codigo_produto,i.codigo_prod_unid_med,count(*)::int itens,count(distinct r.id)::int requisicoes from compras_requisicoes r join compras_requisicoes_itens i on i.requisicao_id=r.id where coalesce(r.data_abertura_alvo,r.created_at)>=date '2026-09-07'-90 group by i.codigo_produto,i.codigo_prod_unid_med) select a.*,p.unidade_medida as unidade_catalogo_geral,coalesce((select jsonb_agg(to_jsonb(u) order by posicao) from stock_produto_unidades u where u.codigo_produto=a.codigo_produto),'[]'::jsonb) as escala_disponivel from usados a left join stock_products p using(codigo_produto) order by a.codigo_produto,a.codigo_prod_unid_med",
