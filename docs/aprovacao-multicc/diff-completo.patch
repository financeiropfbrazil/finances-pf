+
+  let maiorNumeroVisto = lastKnownNumero;
+
+  for (const ped of novos) {
+    try {
+      if (!ped.Numero) {
+        console.warn(`[descobrir-ped] pedido sem Numero, ignorado:`, ped);
+        continue;
+      }
