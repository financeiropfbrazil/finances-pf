+-- Objetos novos têm conteúdo vinculado por SHA-256 ao metadado congelado.
+alter table public.compras_requisicoes_arquivos add column conteudo_sha256 text
+ check (conteudo_sha256 ~ '^[0-9a-f]{64}$');
