+    result.detalhes.push({
+      tipo: "ped",
+      id: "",
+      numero_alvo: "",
+      erro: `GET /ped-comp/list falhou: HTTP ${resp.status} - ${resp.data?.error || "desconhecido"}`,
+    });
+    return { result, crossCheck };
+  }
