+       raise exception 'ANEXO_CONGELADO'; end if;
+     if v_req.aprovacao_submetida_em is not null and v_req.numero_alvo is null then raise exception 'REQUISICAO_CONGELADA: itens e rateio nao podem mudar'; end if;
