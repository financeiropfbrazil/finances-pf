+    if (errCursorUpdate) {
+      console.error("[descobrir-ped] falhou atualizando cursor:", errCursorUpdate);
+    } else {
+      console.log(`[descobrir-ped] cursor atualizado: ${lastKnownNumero} → ${maiorNumeroVisto}`);
+    }
