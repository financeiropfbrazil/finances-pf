+          valor_frete: ped.ValorFrete ?? 0,
+          codigo_cond_pag: ped.CondPagPedCompObject?.CodigoCondPag ?? null,
+          // ⚠️ ANTI-WIPE (MOEDA-PEDIDOS): `codigo_ind_economico` e
+          // `valor_cambio` estão AUSENTES daqui de propósito. Este objeto
